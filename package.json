{
  "name": "mediaplayer-multiplatform",
  "version": "0.0.1",
  "description": "mediaPlayer multi-platform Quasar skeleton for PC, Android phone and Android Pad",
  "productName": "mediaPlayer MultiPlatform",
  "author": "OpenClaw",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev -m electron",
    "dev:spa": "quasar dev",
    "dev:electron": "quasar dev -m electron",
    "dev:android": "quasar dev -m capacitor -T android",
    "dev:android:emulator": "node scripts/android-dev-server.mjs",
    "dev:android:device": "node scripts/android-dev-server.mjs --device",
    "build": "quasar build",
    "build:spa": "quasar build -m spa",
    "build:electron": "quasar build -m electron",
    "build:android": "quasar build -m capacitor -T android",
    "android:sync": "quasar build -m capacitor -T android --skip-pkg",
    "android:open": "node scripts/capacitor-cli.mjs open android",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@quasar/extras": "^2.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "artplayer": "^5.4.0",
    "artplayer-plugin-dash-control": "^1.1.0",
    "artplayer-plugin-hls-control": "^1.1.0",
    "dashjs": "^5.2.1",
    "element-plus": "^2.14.5",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "flv.js": "^1.6.2",
    "hls.js": "^1.7.3",
    "pinia": "^4.0.2",
    "quasar": "^2.24.0",
    "tailwindcss": "^4.3.3",
    "vant": "^4.10.2",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.5.0",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "electron": "^43.4.0",
    "postcss": "^8.5.8",
    "sass": "^1.104.1",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
