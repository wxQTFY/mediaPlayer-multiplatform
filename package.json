{
  "name": "mediaplayer-multiplatform",
  "version": "0.0.1",
  "description": "mediaPlayer multi-platform Quasar skeleton for PC, Android phone and Android Pad",
  "productName": "mediaPlayer MultiPlatform",
  "author": "OpenClaw",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev -m electron",
    "dev:spa": "quasar dev",
    "dev:electron": "quasar dev -m electron",
    "dev:android": "quasar dev -m capacitor -T android",
    "build": "quasar build",
    "build:spa": "quasar build -m spa",
    "build:electron": "quasar build -m electron",
    "build:android": "quasar build -m capacitor -T android",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.3",
    "pinia": "^4.0.2",
    "quasar": "^2.24.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.5.0",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "electron": "^43.4.0",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
